              "script": {
                "exec": [
                  "// Parse the JSON response",
                  "let response = pm.response.json();",
                  "",
                  "// verify backend returns id property",
                  "pm.test(\"Successful POST request\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(response).to.have.property(\"id\");",
                  "});",
                  "",
                  "// Save id as env variable",
                  "if (response.id) {",
                  "    pm.environment.set(\"author_id\", response.id);",
                  "    console.log(\"✅ Saved author_id:\", response.id);",
                  "} else {",
                  "    console.warn(\"⚠️ No 'id' found in response:\", response);",
